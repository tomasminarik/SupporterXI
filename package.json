{
  "name": "supporter-xi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run validate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "catalogues:generate": "node scripts/generate-catalogues.mjs",
    "catalogues:check": "node scripts/generate-catalogues.mjs --check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "validate": "npm run catalogues:check && npm run content:check && npm test",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:browser && npm run test:workbench",
    "test:workbench": "playwright test --config playwright.workbench.config.ts",
    "content:generate": "node scripts/generate-squad.mjs",
    "content:check": "node scripts/generate-squad.mjs --check",
    "prevalidate": "npm run content:generate"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "1.3.0",
    "antd": "6.6.5",
    "next": "16.4.0",
    "posthog-js": "1.438.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
